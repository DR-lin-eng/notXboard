APP_NAME=XBoard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_MEMORY_LIMIT=512M
PORT=8000
SUBSCRIBE_PATH=s
APP_ENV_FILE=./.env

LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=info
BACKUP_LOG_STACK=stderr

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xboard
DB_USERNAME=xboard
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
DB_MAX_CONNECTIONS=128
DB_MIN_CONNECTIONS=16
DB_ACQUIRE_TIMEOUT_SECS=5
DB_IDLE_TIMEOUT_SECS=300
DB_WRITE_RETRY_ATTEMPTS=3
DB_WRITE_RETRY_BACKOFF_MS=25
SETTING_CACHE_TTL_SECS=3
NODE_ACCESS_CACHE_TTL_SECS=3
PUSH_TRAFFIC_QUEUE_CAPACITY=20000
PUSH_TRAFFIC_FLUSH_INTERVAL_MS=50
PUSH_TRAFFIC_MAX_BATCH_JOBS=512
PUSH_TRAFFIC_MAX_BATCH_ROWS=20000
ALIVE_SESSION_QUEUE_CAPACITY=20000
ALIVE_SESSION_FLUSH_INTERVAL_MS=50
ALIVE_SESSION_MAX_BATCH_JOBS=512
ALIVE_SESSION_MAX_BATCH_USERS=20000
LEGACY_SUBMIT_QUEUE_CAPACITY=20000
LEGACY_SUBMIT_FLUSH_INTERVAL_MS=50
LEGACY_SUBMIT_MAX_BATCH_JOBS=512
LEGACY_SUBMIT_MAX_BATCH_ROWS=20000

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=sync
CORE_JOB_SYNC_EXECUTION=true
PHP_HTTP_API_COMPAT=false
PHP_SERVER_INGRESS_COMPAT=false
PHP_WEB_COMPAT=false
QUEUE_RETRY_AFTER=180
QUEUE_BLOCK_FOR=5
SESSION_SECURE_COOKIE=true
OCTANE_ENABLE_TICK_SCHEDULER=false
SERVER_USER_PULL_MEMORY_LIMIT=512M

HORIZON_FAST_TERMINATION=true
HORIZON_MEMORY_LIMIT=256
HORIZON_ALLOWED_EMAILS=
HORIZON_CORE_MIN_PROCESSES=4
HORIZON_CORE_MAX_PROCESSES=24
HORIZON_CORE_MEMORY=256
HORIZON_CORE_MAX_JOBS=1000
HORIZON_CORE_MAX_TIME=3600
HORIZON_NOTIFY_MIN_PROCESSES=1
HORIZON_NOTIFY_MAX_PROCESSES=4
HORIZON_NOTIFY_MEMORY=128
HORIZON_NOTIFY_MAX_JOBS=1000
HORIZON_NOTIFY_MAX_TIME=3600

MAIL_DRIVER=log
MAIL_SYNC_SEND=true
TELEGRAM_SYNC_SEND=true
TELEGRAM_ONLY_MODE=true
MAIL_HOST=
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME=null
MAILGUN_DOMAIN=
MAILGUN_SECRET=

# google cloud storage
ENABLE_AUTO_BACKUP_AND_UPDATE=false
ENABLE_SCHEDULED_MAIL_REMINDERS=false
BACKUP_SCHEDULE_AT=03:30
GOOGLE_CLOUD_KEY_FILE=config/googleCloudStorageKey.json
GOOGLE_CLOUD_STORAGE_BUCKET=

# Linux DO Connect OAuth2
LINUX_DO_CLIENT_ID=
LINUX_DO_CLIENT_SECRET=

# Prevent reinstallation
INSTALLED=false
